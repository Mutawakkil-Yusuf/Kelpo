{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kelpo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",

  // Built Vite SPA. Worker handles API/OG/pages; everything else is static.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Locally emulated by wrangler dev. For production, replace database_id
  // with the real D1 database id from `wrangler d1 create kelpo`, and create
  // the bucket with `wrangler r2 bucket create kelpo-files`.
  "d1_databases": [
    { "binding": "DB", "database_name": "kelpo", "database_id": "kelpo-local" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "kelpo-files" }
  ],

  // Exact-expiry cleanup; see src/worker/lib/cleanup.ts (stub).
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "APP_URL": "http://localhost:8787"
  }
}
