{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kelpo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",

  // Locally emulated by wrangler dev. The database id below is the hosted D1
  // database created for Kelpo. Storage lives in Supabase, not R2.
  "d1_databases": [
    { "binding": "DB", "database_name": "kelpo", "database_id": "5b81a104-ba00-4ea6-830b-b4cd973277c6" }
  ],
  // Supabase Storage holds originals. Set SUPABASE_SERVICE_KEY as a secret with
  // `wrangler secret put SUPABASE_SERVICE_KEY` (or in .dev.vars locally).

  // Exact-expiry cleanup; see src/worker/lib/cleanup.ts.
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "APP_URL": "https://kelpo.mutawakkil280.workers.dev",
    "PUBLIC_APP_URL": "https://kelpo.vercel.app",
    "ALLOWED_ORIGIN": "https://kelpo.vercel.app,*.vercel.app",
    "SUPABASE_URL": "https://wuzggadpxpijybqjshhh.supabase.co",
    "STORAGE_BUCKET": "kelpo-files"
  }
}
