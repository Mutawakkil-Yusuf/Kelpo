{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kelpo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",

  // Locally emulated by wrangler dev. For production, replace database_id
  // with the real D1 database id from `wrangler d1 create kelpo`, and create
  // the bucket with `wrangler r2 bucket create kelpo-files`.
  "d1_databases": [
    { "binding": "DB", "database_name": "kelpo", "database_id": "5b81a104-ba00-4ea6-830b-b4cd973277c6" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "kelpo-files" }
  ],

  // Exact-expiry cleanup; see src/worker/lib/cleanup.ts.
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "APP_URL": "https://kelpo.mutawakkil280.workers.dev",
    "PUBLIC_APP_URL": "https://kelpo.vercel.app",
    "ALLOWED_ORIGIN": "https://kelpo.vercel.app,*.vercel.app"
  }
}
