# Local development is credential-free: wrangler dev emulates D1/R2/cron.
# For a deployed Worker these are set with `wrangler secret put` / wrangler vars.

# Public origin of the app, no trailing slash. Used in share links and OG tags.
APP_URL=http://localhost:8787

# Optional: secret used to sign access/owner cookies. Generate with:
#   openssl rand -base64 32
# If unset, a random per-process value is used in dev (sessions won't survive restarts).
SESSION_SECRET=
