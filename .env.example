# ── Local development ──────────────────────────────────────────────────────────
# wrangler dev emulates D1/R2/cron locally. No Cloudflare account needed.
# Leave VITE_API_URL empty so Vite proxies /api and /p to localhost:8787.

# ── Production: Cloudflare Worker ─────────────────────────────────────────────
# Set with `wrangler secret put` / wrangler vars, not in this file.
# APP_URL=https://kelpo-api.<your-subdomain>.workers.dev
# PUBLIC_APP_URL=https://usekelpo.vercel.app
# ALLOWED_ORIGIN=https://usekelpo.vercel.app,*.vercel.app
# SESSION_SECRET=            # openssl rand -base64 32
# SUPABASE_SERVICE_KEY=      # set with `wrangler secret put SUPABASE_SERVICE_KEY`

# ── Production: Vercel ────────────────────────────────────────────────────────
# VITE_API_URL=https://kelpo-api.<your-subdomain>.workers.dev
# KELPO_API_URL=https://kelpo-api.<your-subdomain>.workers.dev
# VITE_SITE_URL=https://usekelpo.vercel.app
